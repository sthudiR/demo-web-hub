---
import Base from '../layouts/Base.astro';
import registry from '../data/sites.json';
const url = (id: string) => registry.find((s) => s.id === id)!.url;
const rows = [
  { goal: 'Write lessons or a course', tool: 'Quarto', id: 'demo-web-quarto', demo: 'Window Garden', watch: 'Interactivity comes from embedded code or other tools.' },
  { goal: 'Run Python with sliders in the browser', tool: 'marimo (WebAssembly)', id: 'demo-web-marimo', demo: 'Lemonade Lab', watch: 'The first visit downloads Python, about 5 seconds. One page per notebook.' },
  { goal: 'Make an animation or visual', tool: 'p5.js', id: 'demo-web-p5', demo: 'Starling Sky', watch: 'It draws and nothing more, so you build the pages around it.' },
  { goal: 'Show a 3D model people can move', tool: 'Vite + React + Three.js', id: 'demo-web-sim', demo: 'Pocket Tides', watch: 'The most code of the six. Worth it only for real-time 3D.' },
  { goal: 'Publish docs and a code reference', tool: 'Sphinx + Furo', id: 'demo-web-reference', demo: 'Coffee Atlas', watch: 'More setup than Markdown-only tools; shines for Python, C++ and other API docs.' },
  { goal: 'Give people code to edit and run', tool: 'Jupyter Book + JupyterLite', id: 'demo-web-notebooks', demo: 'Sourdough Lab', watch: 'Heavy: the published site is 84 MB.' },
  { goal: 'Tie it all together', tool: 'Astro + GitHub Pages + Actions', id: 'demo-web-hub', demo: 'This hub', watch: 'Pages hosts static files only.' },
];
const hub = 'https://sthudir.github.io/demo-web-hub/';
---
<Base title="What can I use for…? · Small Labs">
  <section class="hero">
    <h1>What can I use for…?</h1>
    <p>Start from what you want to make. Each row points to a tool and a live demo of it.</p>
  </section>
  <table class="which">
    <thead><tr><th>I want to…</th><th>Use</th><th>See it in</th><th>Watch out for</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td class="goal">{r.goal}</td>
          <td>{r.tool}</td>
          <td><a href={r.id === 'demo-web-hub' ? hub : url(r.id)}>{r.demo}</a></td>
          <td class="watch">{r.watch}</td>
        </tr>
      ))}
      <tr>
        <td class="goal">Need logins, a database or a server</td>
        <td>Not GitHub Pages</td>
        <td>-</td>
        <td class="watch">Pages is static. Host the server part elsewhere and link to it or embed it.</td>
      </tr>
    </tbody>
  </table>
</Base>
