---
import Base from '../layouts/Base.astro';
import SiteCard from '../components/SiteCard.astro';
import { loadSites } from '../data/load-sites';
const sites = await loadSites();
const base = import.meta.env.BASE_URL;
---
<Base title="Small Labs">
  <section class="hero">
    <h1>Three small labs, ready to play with.</h1>
    <p>Bake a better loaf with live Python, push the moon around a tide simulator, or look up where your coffee comes from. Pick one and dive in.</p>
  </section>
  <section class="grid">
    {sites.map((s) => <SiteCard site={s} previewHref={`${base}preview/${s.id}/`} />)}
  </section>
</Base>
